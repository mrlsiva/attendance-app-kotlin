<?xml version="1.0" encoding="utf-8"?>
    <androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/uv_main_layer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardUseCompatPadding="true"
    app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
    android:layout_margin="@dimen/_5sdp"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@color/white">
    <LinearLayout
        android:id="@+id/shiftView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="16dp">

        <ImageView
            android:id="@+id/circularImageView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/admin_shit_time_viol"
            android:background="@drawable/circular_background_white" />

        <LinearLayout
            android:id="@+id/textlayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:id="@+id/boldTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bold Text"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/normalTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Normal Text"
                android:textColor="@color/grey1"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/roundedButton"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_25sdp"
            android:text="Edit"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:background="@drawable/text_button_dark_blue" />

    </LinearLayout>
    <View
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/divider_line"
        app:layout_constraintTop_toBottomOf="@+id/shiftView"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/bottom"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:gravity="start"
        android:layout_weight="1"
        android:paddingBottom="@dimen/_10sdp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Time"
            android:textColor="@color/grey1"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/startval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="08:30"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="end"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/start1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="End Time"
                android:textColor="@color/grey1"
                android:gravity="end"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/startval2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="08:30"
                android:gravity="end"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>