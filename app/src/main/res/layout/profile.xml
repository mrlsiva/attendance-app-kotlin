<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">
    <!-- res/layout/list_item.xml -->
    <LinearLayout
        android:id="@+id/pro_top_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="16dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/circularImageView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/menu_user_profile"
            android:background="@drawable/circular_background_white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/profile_design"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Designation"

                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/roundedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_30sdp"
            android:text="Edit"
            android:layout_gravity="center_vertical"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:background="@drawable/rounded_border_btn" />

    </LinearLayout>

    <View
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/divider_line"
        app:layout_constraintTop_toBottomOf="@+id/pro_top_section"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/bottom"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/_10sdp"
        android:gravity="start"
        android:orientation="horizontal"
        android:paddingTop="@dimen/_5sdp"
        android:paddingBottom="@dimen/_5sdp">

        <ImageView
            android:layout_width="@dimen/profile_icon"
            android:layout_height="@dimen/profile_icon"
            android:scaleType="fitXY"
            android:layout_gravity="center_vertical"
            android:src="@drawable/pro_email" />

        <TextView
            android:id="@+id/profile_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/logoImageView"
            android:text="ravi@gmail.com"
            android:layout_gravity="center_vertical"
            android:textColor="@color/font_color"
            android:layout_marginStart="@dimen/_10sdp"
            android:textColorHint="@android:color/darker_gray"
            android:textStyle="bold" />
    </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_10sdp"
            android:gravity="start"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp">

            <ImageView
                android:layout_width="@dimen/profile_icon"
                android:layout_height="@dimen/profile_icon"
                android:scaleType="fitXY"
                android:layout_gravity="center_vertical"
                android:src="@drawable/pro_location" />

            <TextView
                android:id="@+id/profile_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/logoImageView"
                android:text="21, Sabari street, Nesapakakam, kk Nagar west, chennai"
                android:textColor="@color/font_color"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_10sdp"
                android:textColorHint="@android:color/darker_gray"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_10sdp"
            android:gravity="start"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp">

            <ImageView
                android:layout_width="@dimen/profile_icon"
                android:layout_height="@dimen/profile_icon"
                android:scaleType="fitXY"
                android:layout_gravity="center_vertical"
                android:src="@drawable/pro_phone" />

            <TextView
                android:id="@+id/profile_mobile_no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/logoImageView"
                android:text="9876543210"
                android:textColor="@color/font_color"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_10sdp"
                android:textColorHint="@android:color/darker_gray"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_10sdp"
            android:gravity="start"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp">

            <ImageView
                android:layout_width="@dimen/profile_icon"
                android:layout_height="@dimen/profile_icon"
                android:scaleType="fitXY"
                android:layout_gravity="center_vertical"
                android:src="@drawable/pro_lock" />

            <TextView
                android:id="@+id/profile_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="*********"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:textColor="@color/font_color"
                android:layout_marginStart="@dimen/_10sdp"
                android:textColorHint="@android:color/darker_gray"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_10sdp"
            android:gravity="start"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp">

            <ImageView
                android:layout_width="@dimen/profile_icon"
                android:layout_height="@dimen/profile_icon"
                android:scaleType="fitXY"
                android:src="@drawable/pro_logout" />

            <TextView
                android:id="@+id/profile_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/logoImageView"
                android:text="Logout"
                android:layout_gravity="center_vertical"
                android:textColor="@color/font_color"
                android:layout_marginStart="@dimen/_10sdp"
                android:textColorHint="@android:color/darker_gray"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>