<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#FBFBFB"
    tools:context=".ui.CalendarLog.CalendarLogFragment">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="@dimen/_3sdp"
        android:minHeight="?attr/actionBarSize"
        android:textAlignment="textStart"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:tabIndicatorColor="@color/theme_blue"
        app:tabIndicatorHeight="@dimen/_2sdp"
        app:tabMode="fixed"
        app:tabBackground="@color/white"
        app:tabTextColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:tabRippleColor="@color/ripple_material_light"
        />
<!--    app:tabSelectedTextColor="@color/bottom_nav_text_color"
    app:tabTextAppearance="@style/tab_bg"
    app:tabTextColor="@color/tabGray"
    app:tabIndicator="@drawable/dot_bottom_nav_indi_bg"
    android:background="@color/grey4"-->

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:isScrollContainer="false"
        android:nestedScrollingEnabled="true"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>

</androidx.constraintlayout.widget.ConstraintLayout>