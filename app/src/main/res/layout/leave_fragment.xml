<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/pagebackground1">
    <!-- res/layout/list_item.xml -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pagebackground1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pagebackground1">

            <LinearLayout
                android:id="@+id/pro_top_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/circularImageView"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/menu_user_profile"
                    android:background="@drawable/circular_background_white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:id="@+id/boldTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mr. Ravi Kumar"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/normalTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manager"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/leave_data"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:paddingBottom="@dimen/_100sdp"
                app:layout_constraintTop_toBottomOf="@+id/pro_top_section"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/_10sdp"
                    android:gravity="start"
                    app:cardCornerRadius="@dimen/_5sdp"
                    app:cardBackgroundColor="@color/white"
                    app:cardUseCompatPadding="true"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_5sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:orientation="vertical"
                        android:background="@color/white">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/logoImageView"
                            android:text="This Month Leave &amp; Permissions"
                            android:layout_gravity="center_vertical"
                            android:textColor="@color/font_color"
                            android:background="@color/white"
                            android:textColorHint="@android:color/darker_gray"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="4dp"
                            android:background="@color/white"
                            android:layout_marginTop="@dimen/_10sdp"
                            app:layout_constraintTop_toBottomOf="@+id/title_layout">

                            <TextView
                                android:id="@+id/date"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Leave"
                                android:background="@color/white"
                                android:textSize="14sp"
                                android:paddingTop="@dimen/_5sdp"
                                android:paddingBottom="@dimen/_5sdp"
                                android:layout_weight="1"
                                android:textColor="@color/font_title_color"
                                />

                            <TextView
                                android:id="@+id/punchin"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="2 Days"
                                android:background="@color/white"
                                android:gravity="center"
                                android:textSize="14sp"
                                android:textColor="@color/black"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <View
                            android:id="@+id/bottom"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_1sdp"
                            android:background="@color/divider_line"
                            app:layout_constraintTop_toBottomOf="@+id/pro_top_section"
                            app:layout_constraintStart_toStartOf="parent"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="4dp"
                            android:background="@color/white"
                            app:layout_constraintTop_toBottomOf="@+id/title_layout">

                            <TextView
                                android:id="@+id/date1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Permission"
                                android:textSize="14sp"
                                android:paddingTop="@dimen/_5sdp"
                                android:paddingBottom="@dimen/_5sdp"
                                android:layout_weight="1"
                                android:background="@color/white"
                                android:textColor="@color/font_title_color"
                                />

                            <TextView
                                android:id="@+id/punchin2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="6 Hours"
                                android:gravity="center"
                                android:textSize="14sp"
                                android:textColor="@color/black"
                                android:background="@color/white"
                                android:layout_weight="1"
                                />
                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_70sdp"
                    android:gravity="start"
                    app:cardCornerRadius="@dimen/_5sdp"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@color/white"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_5sdp">
                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/_10sdp"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/_5sdp"
                        android:paddingBottom="@dimen/_5sdp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/logoImageView"
                            android:text="Leave &amp; Permission Advance Apply"
                            android:textColor="@color/font_color"
                            android:layout_gravity="center_vertical"
                            android:textColorHint="@android:color/darker_gray"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/logoImageView"
                            android:text="Leave"
                            android:textColor="@color/font_title_color"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:layout_gravity="center_vertical"
                            android:textColorHint="@android:color/darker_gray" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/logoImageView"
                            android:text="18/12/2023"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:textColor="@color/font_color"
                            android:layout_gravity="center_vertical"
                            android:textColorHint="@android:color/darker_gray" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/logoImageView"
                            android:text="Reason"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:textColor="@color/font_title_color"
                            android:layout_gravity="center_vertical"
                            android:textColorHint="@android:color/darker_gray" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/logoImageView"
                            android:text="Lorem sample Lorem sample Lorem sample "
                            android:textColor="@color/font_color"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:textColorHint="@android:color/darker_gray" />

                        <View
                            android:id="@+id/separ_layer1"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_1sdp"
                            android:background="@color/divider_line"
                            android:layout_marginTop="@dimen/_10sdp"
                            app:layout_constraintTop_toBottomOf="@+id/pro_top_section"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/logoImageView"
                            android:text="Permission"
                            android:textColor="@color/font_title_color"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:textColorHint="@android:color/darker_gray" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/logoImageView"
                            android:text="11.00 AM - 12.00 P.M at 16/12/2023"
                            android:textColor="@color/font_color"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:layout_gravity="center_vertical"
                            android:textColorHint="@android:color/darker_gray" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/logoImageView"
                            android:text="Reason"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:textColor="@color/font_title_color"
                            android:layout_gravity="center_vertical"
                            android:textColorHint="@android:color/darker_gray" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/logoImageView"
                            android:text="Lorem sample Lorem sample Lorem sample "
                            android:textColor="@color/font_color"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:layout_gravity="center_vertical"
                            android:textColorHint="@android:color/darker_gray" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/leave_no_data"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_10sdp"
                android:gravity="start"
                android:orientation="horizontal"
                app:cardUseCompatPadding="true"
                android:visibility="gone"
                android:paddingTop="@dimen/_5sdp"
                app:cardCornerRadius="@dimen/_5sdp"
                android:backgroundTint="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pro_top_section"
                android:paddingBottom="@dimen/_5sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:backgroundTint="@color/white">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No Leave &amp; Permissions"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:paddingTop="@dimen/_30sdp"
                        android:paddingBottom="@dimen/_30sdp"
                        android:textColor="@color/font_color"
                        android:textColorHint="@android:color/darker_gray"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>