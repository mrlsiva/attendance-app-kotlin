<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFCFC">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo ImageView -->

        <!-- Username InputLayout -->

        <!--   </com.google.android.material.textfield.TextInputLayout>-->

        <!-- Password InputLayout -->

        <TextView
            android:id="@+id/dateTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins_regular"
            android:textColorHint="@android:color/darker_gray" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/dateEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:hint="Select Date"
            android:textColorHint="@color/purple_500"
            android:layout_below="@+id/dateTx"
            android:paddingTop="@dimen/_10sdp"
            android:drawableTint="@color/theme_blue"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="@dimen/_10sdp"
            android:background="@drawable/edittext_rounded_border" />

        <TextView
            android:id="@+id/reasonTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Reason for leave"
            android:textStyle="bold"
            android:layout_below="@+id/dateEt"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins_regular"
          />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/reasonEd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:hint="Enter reason"
            android:textColorHint="@color/purple_500"
            android:layout_below="@+id/reasonTx"
            android:paddingTop="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="@dimen/_10sdp"
            android:background="@drawable/edittext_rounded_border" />

        <!-- Submit Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/submitBtn"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:paddingTop="15dp"
            android:fontFamily="@font/poppins_regular"
            android:layout_below="@+id/reasonEd"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:paddingBottom="15dp"
            android:background="@drawable/rounded_button"
            android:text="Apply Leave" />

    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>