<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/user_layer"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_10sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- res/layout/list_item.xml -->

        <ImageView
            android:id="@+id/circularImageView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/menu_user_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/circular_background_white" />

        <LinearLayout
            android:id="@+id/textlayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:layout_constraintStart_toEndOf="@+id/circularImageView"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:id="@+id/boldTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bold Text"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/normalTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Normal Text"
                android:textColor="@color/grey1"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/roundedButton"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_25sdp"
            android:text="Edit"
            android:textSize="@dimen/_8sdp"
            android:gravity="center"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textAllCaps="false"
            app:layout_constraintEnd_toStartOf="@+id/textButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/text_button_dark_blue" />

        <Button
            android:id="@+id/textButton"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_25sdp"
            android:text="View"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_gravity="center"
            android:textColor="@color/theme_blue"
            android:textAllCaps="false"
            android:textSize="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/rounded_button_light_blue" />

</androidx.constraintlayout.widget.ConstraintLayout>