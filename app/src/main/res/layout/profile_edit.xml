<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFCFC">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainNestView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingBottom="@dimen/_15sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/submitBtn">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo ImageView -->

        <!-- Username InputLayout -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/logoImageView"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:background="@color/white"
            android:layout_centerHorizontal="true"
            android:src="@drawable/menu_user_profile" />

        <ImageView
            android:id="@+id/edit_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/logoImageView"
            android:src="@drawable/pro_edit"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="-20dp"
            android:layout_alignRight="@+id/logoImageView"
            android:layout_centerHorizontal="true"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/fnameTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="First Name"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_below="@+id/logoImageView"
            android:textColor="@color/black"
            android:textColorHint="@android:color/darker_gray" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/fnameEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:textColorHint="@color/purple_500"
                android:paddingTop="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:fontFamily="@font/poppins_regular"
                android:paddingStart="@dimen/_10sdp"
                android:hint="Enter First Name"
                android:layout_below="@+id/fnameTx"
                android:background="@drawable/edittext_rounded_border" />

     <!--   </com.google.android.material.textfield.TextInputLayout>-->

        <!-- Password InputLayout -->
        <TextView
            android:id="@+id/lastNameTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last Name"
            android:textStyle="bold"
            android:layout_below="@+id/fnameEt"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins_regular"
            android:textColorHint="@android:color/darker_gray" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/lastNameEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:hint="Enter Last Name"
                android:textColorHint="@color/purple_500"
                android:layout_below="@+id/lastNameTx"
                android:paddingTop="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:fontFamily="@font/poppins_regular"
                android:paddingStart="@dimen/_10sdp"
                android:background="@drawable/edittext_rounded_border" />

        <TextView
            android:id="@+id/designatTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Designation"
            android:textStyle="bold"
            android:layout_below="@+id/lastNameEt"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins_regular"
            android:textColorHint="@android:color/darker_gray" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/designEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:hint="Enter Designation"
            android:textColorHint="@color/purple_500"
            android:layout_below="@+id/designatTx"
            android:paddingTop="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="@dimen/_10sdp"
            android:background="@drawable/edittext_rounded_border" />

        <TextView
            android:id="@+id/mailTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mail"
            android:textStyle="bold"
            android:layout_below="@+id/designEt"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins_regular"
            android:textColorHint="@android:color/darker_gray" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/mailEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:hint="Enter Mail"
            android:textColorHint="@color/purple_500"
            android:layout_below="@+id/mailTx"
            android:paddingTop="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="@dimen/_10sdp"
            android:background="@drawable/edittext_rounded_border" />

        <TextView
            android:id="@+id/addressTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textStyle="bold"
            android:layout_below="@+id/mailEt"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins_regular"
            android:textColorHint="@android:color/darker_gray" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/addressEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:hint="Enter Address"
            android:textColorHint="@color/purple_500"
            android:layout_below="@+id/addressTx"
            android:paddingTop="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="@dimen/_10sdp"
            android:background="@drawable/edittext_rounded_border" />

        <TextView
            android:id="@+id/phoneTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone"
            android:textStyle="bold"
            android:layout_below="@+id/addressEt"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins_regular"
            android:textColorHint="@android:color/darker_gray" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/phoneEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:hint="Enter Phone Number"
            android:textColorHint="@color/purple_500"
            android:layout_below="@+id/phoneTx"
            android:paddingTop="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="@dimen/_10sdp"
            android:background="@drawable/edittext_rounded_border" />

        <TextView
            android:id="@+id/passwordTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textStyle="bold"
            android:layout_below="@+id/phoneEt"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins_regular"
            android:textColorHint="@android:color/darker_gray" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/passwordEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:hint="Enter password"
            android:textColorHint="@color/purple_500"
            android:layout_below="@+id/passwordTx"
            android:paddingTop="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="@dimen/_10sdp"
            android:background="@drawable/edittext_rounded_border"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/confPasswordTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirm Password"
            android:textStyle="bold"
            android:layout_below="@+id/passwordEt"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins_regular"
            android:textColorHint="@android:color/darker_gray" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/confPasswordEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:hint="Enter password"
            android:textColorHint="@color/purple_500"
            android:layout_below="@+id/confPasswordTx"
            android:paddingTop="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="@dimen/_10sdp"
            android:text="1234"
            android:background="@drawable/edittext_rounded_border"
            android:inputType="textPassword" />

        <!-- Submit Button -->

    </RelativeLayout>

    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/submitBtn"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/white"
        android:background="@drawable/rounded_button"
        android:text="Submit"
        tools:ignore="MissingConstraints" />
</androidx.constraintlayout.widget.ConstraintLayout>