<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="-50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo ImageView -->

        <!-- Username InputLayout -->
        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_120sdp"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:scaleType="fitCenter"
            android:layout_centerHorizontal="true"
            android:src="@drawable/splash_logo" />

        <TextView
            android:id="@+id/title1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome Back!"
            android:layout_marginTop="20dp"
            android:textSize="@dimen/_20sdp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:layout_below="@+id/logoImageView"
            android:textColorHint="@android:color/darker_gray" />

        <TextView
            android:id="@+id/title2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/title1"
            android:textSize="@dimen/_11sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:fontFamily="@font/poppins_regular"
            android:text="Please Login in to continue."
            android:textColor="@color/purple_700"
            android:textColorHint="@android:color/darker_gray" />

        <TextView
            android:id="@+id/title3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_below="@+id/title2"
            android:textColor="@color/black"
            android:textColorHint="@android:color/darker_gray" />

        <!--       <com.google.android.material.textfield.TextInputLayout
                   android:id="@+id/usernameInputLayout"
                   style="@style/NoBottomLineTextInputLayout"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:paddingTop="5dp"
                   app:hintEnabled="false"
                   android:layout_below="@+id/title3"
                   android:layout_marginBottom="8dp">-->
     <!--   9994333605-->
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/usernameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:textColorHint="@color/purple_500"
            android:paddingTop="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="@dimen/_10sdp"
            android:hint="Enter user name"
            android:text=""
            android:layout_below="@+id/title3"
            android:background="@drawable/edittext_rounded_border" />

        <!--   </com.google.android.material.textfield.TextInputLayout>-->

        <!-- Password InputLayout -->
        <TextView
            android:id="@+id/title4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textStyle="bold"
            android:layout_below="@+id/usernameEditText"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins_regular"
            android:textColorHint="@android:color/darker_gray" />

        <TextView
            android:id="@+id/for_pass_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot Password?"
            android:gravity="right"
            android:textSize="13sp"
            android:visibility="gone"
            android:fontFamily="@font/poppins_regular"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/usernameEditText"
            android:textColor="@color/theme_blue"
            android:layout_marginTop="15dp"
            android:textColorHint="@android:color/darker_gray" />


        <!--        <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordInputLayout"
                    style="@style/NoBottomLineTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_below="@+id/title4"
                    android:layout_height="wrap_content"
                    android:paddingTop="5dp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">-->


        <!-- </com.google.android.material.textfield.TextInputLayout>
 -->
        <!-- Submit Button -->
        <!--  <androidx.appcompat.widget.AppCompatEditText
              android:id="@+id/passwordEditText"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_below="@+id/title4"
              android:layout_marginTop="5dp"
              android:background="@drawable/edittext_rounded_border"
              android:fontFamily="@font/poppins_regular"
              android:hint="Enter password"
              android:inputType="textPassword"
              android:paddingStart="@dimen/_10sdp"
              android:paddingTop="@dimen/_10sdp"
              android:paddingBottom="@dimen/_10sdp"
              android:textColor="@color/black"
              android:textColorHint="@color/purple_500" />
  -->
<!--        vasantham123-->
        <RelativeLayout
            android:id="@+id/passwordEditTextLayer"
            android:layout_width="match_parent"
            android:layout_below="@+id/title4"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/passwordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/edittext_rounded_border"
                android:fontFamily="@font/poppins_regular"
                android:hint="Enter password"
                android:text=""
                android:inputType="textPassword"
                android:paddingStart="@dimen/_10sdp"
                android:paddingTop="@dimen/_10sdp"
                android:paddingEnd="40dp"
                android:paddingBottom="@dimen/_10sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/purple_500" />

            <ImageView
                android:id="@+id/passwordToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignEnd="@id/passwordEditText"
                android:layout_centerVertical="true"
                android:src="@drawable/eye_icon_strike"
                android:padding="@dimen/_10sdp"
                android:contentDescription="Toggle password visibility" />
        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/submitBtn"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:paddingTop="15dp"
            android:fontFamily="@font/poppins_regular"
            android:layout_below="@+id/passwordEditTextLayer"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:paddingBottom="15dp"
            android:background="@drawable/rounded_button"
            android:text="Login" />

    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>